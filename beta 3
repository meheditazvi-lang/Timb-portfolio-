// --- Main Application Component ---
export default function App() {
  const [currentPage, setCurrentPage] = useState(PAGES.HOME);
  
  // Scrolls to the top of the page whenever the route changes
  useEffect(() => {
    window.scrollTo(0, 0);
  }, [currentPage]);

  const renderScreen = () => {
    switch (currentPage) {
      case PAGES.PROJECTS:
        return <ProjectsScreen />;
      case PAGES.ABOUT:
        return <AboutScreen onNavigate={setCurrentPage} />;
      case PAGES.CONTACT:
        return <ContactScreen />;
      case PAGES.HOME:
      default:
        return <HeroSection onNavigate={setCurrentPage} />;
    }
  };

  return (
    <div className="min-h-screen" style={{ backgroundColor: DARK_BG, color: TEXT_LIGHT }}>
      <Navbar currentPage={currentPage} onNavigate={setCurrentPage} />
      
      <main className="container mx-auto px-4 md:px-8 flex-grow">
        {renderScreen()}
      </main>
      
      <Footer />
      
      {/* Custom Styles for Inter Font (Assuming it needs to be declared) */}
      <style global jsx>{`
        body {
          font-family: 'Inter', sans-serif;
        }
      `}</style>
    </div>
  );
}

