// Navigation Bar
const Navbar = ({ currentPage, onNavigate }) => {
  const [isMenuOpen, setIsMenuOpen] = useState(false);

  const navItems = [
    { name: 'Home', page: PAGES.HOME },
    { name: 'Projects', page: PAGES.PROJECTS },
    { name: 'About Me', page: PAGES.ABOUT },
    { name: 'Contact Me', page: PAGES.CONTACT },
  ];

  const handleNavClick = (page) => {
    onNavigate(page);
    setIsMenuOpen(false); // Close menu on selection
  };

  return (
    <header className="container mx-auto px-4 py-4 md:py-6 sticky top-0 z-20" style={{ backgroundColor: DARK_BG }}>
      <nav className="flex justify-between items-center">
        <div className="text-2xl font-extrabold" style={{ color: ACCENT_COLOR }}>Timb</div>
        
        {/* Desktop Navigation */}
        <div className="hidden md:flex space-x-8 text-sm font-medium text-gray-300">
          {navItems.map(item => (
            <button
              key={item.page}
              onClick={() => handleNavClick(item.page)}
              className={`transition duration-150 hover:text-white ${currentPage === item.page ? 'text-white border-b-2 border-accent' : 'text-gray-400'}`}
              style={{ borderColor: ACCENT_COLOR }}
            >
              {item.name}
            </button>
          ))}
        </div>

        {/* Mobile Menu Button */}
        <button 
          className="md:hidden p-2 rounded-lg hover:bg-gray-800 transition duration-150" 
          aria-label="Open menu"
          onClick={() => setIsMenuOpen(!isMenuOpen)}
          style={{ color: TEXT_LIGHT }}
        >
          {isMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
        </button>
      </nav>

      {/* Mobile Menu Dropdown */}
      {isMenuOpen && (
        <div 
          className="md:hidden absolute left-0 w-full p-4 mt-2 rounded-lg shadow-xl"
          style={{ backgroundColor: CARD_BG }}
        >
          {navItems.map(item => (
            <button
              key={item.page}
              onClick={() => handleNavClick(item.page)}
              className={`block w-full text-left py-3 px-4 font-medium transition duration-150 rounded-lg ${
                currentPage === item.page ? 'text-white' : 'text-gray-400 hover:text-accent'
              }`}
              style={currentPage === item.page ? { color: ACCENT_COLOR } : {}}
            >
              {item.name}
            </button>
          ))}
        </div>
      )}
    </header>
  );
};

